<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="appointment_listing" name="Appointment Listing">
        <t t-call="website.layout">
            <div class="container my-5 o_appointment_listing">
                <div class="row">
                    <div class="col-12">
                        <h1 class="mb-4">Book an Appointment</h1>
                        <p class="text-muted">Select one of the available slots to plan your next visit.</p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="list-group">
                            <a t-attf-href="/appointments" t-att-class="'list-group-item list-group-item-action' + (' active' if not selected_service else '')">All services</a>
                            <a t-foreach="services" t-as="service" t-attf-href="/appointments/service/#{service.id}" t-att-class="'list-group-item list-group-item-action' + (' active' if selected_service and selected_service.id == service.id else '')">
                                <t t-esc="service.name"/>
                            </a>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="row g-3">
                            <t t-if="slots">
                                <t t-foreach="slots" t-as="slot">
                                    <div class="col-md-6">
                                        <div class="card h-100">
                                            <div class="card-body d-flex flex-column">
                                                <h5 class="card-title" t-esc="slot.name"/>
                                                <p class="card-subtitle text-muted mb-2">
                                                    <t t-esc="slot.start_datetime"/> – <t t-esc="slot.end_datetime"/>
                                                </p>
                                                <p class="flex-grow-1" t-esc="slot.service_id.description"/>
                                                <p class="fw-semibold">
                                                    Remaining places: <t t-esc="slot.available_capacity"/>
                                                </p>
                                                <a t-attf-href="/appointments/book/#{slot.id}" class="btn btn-primary mt-auto">Book now</a>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="col-12">
                                    <div class="alert alert-info">No appointment slots are currently available. Please check again later.</div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="appointment_booking" name="Appointment Booking Form">
        <t t-call="website.layout">
            <div class="container my-5">
                <div class="row">
                    <div class="col-lg-8 mx-auto">
                        <h1 class="mb-3">Confirm your appointment</h1>
                        <p class="text-muted">You are booking the following slot:</p>
                        <div class="card mb-4">
                            <div class="card-body">
                                <h5 class="card-title" t-esc="slot.name"/>
                                <p class="card-text">
                                    <strong>Date:</strong>
                                    <span t-esc="slot.start_datetime"/>
                                    <br/>
                                    <strong>Ends:</strong>
                                    <span t-esc="slot.end_datetime"/>
                                    <br/>
                                    <strong>Service:</strong>
                                    <span t-esc="slot.service_id.name"/>
                                </p>
                                <p class="mb-0">
                                    Remaining places: <span t-esc="slot.available_capacity"/>
                                </p>
                            </div>
                        </div>
                        <div t-if="error" class="alert alert-danger" role="alert">
                            <t t-esc="error"/>
                        </div>
                        <form class="o_appointment_booking_form" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-3">
                                <label class="form-label" for="partner_name">Name</label>
                                <input type="text" name="partner_name" id="partner_name" class="form-control" required="required" t-att-value="partner_name or ''"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="partner_email">Email</label>
                                <input type="email" name="partner_email" id="partner_email" class="form-control" required="required" t-att-value="partner_email or ''"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="partner_phone">Phone</label>
                                <input type="tel" name="partner_phone" id="partner_phone" class="form-control" t-att-value="partner_phone or ''"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="notes">Notes</label>
                                <textarea name="notes" id="notes" class="form-control" rows="4"><t t-esc="notes or ''"/></textarea>
                            </div>
                            <input type="hidden" name="slot_id" t-att-value="slot.id"/>
                            <input type="hidden" name="website_source" t-att-value="website_source or request.httprequest.referrer"/>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="text-muted" data-appointment-summary="">
                                    <t t-esc="slot.name"/>
                                </div>
                                <button type="submit" class="btn btn-primary">Book appointment</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="appointment_confirmation" name="Appointment Confirmation">
        <t t-call="website.layout">
            <div class="container my-5">
                <div class="row">
                    <div class="col-lg-8 mx-auto text-center">
                        <h1 class="mb-4">Thank you!</h1>
                        <p class="lead">Your appointment has been booked successfully.</p>
                        <div class="card mt-4">
                            <div class="card-body">
                                <h5 class="card-title" t-esc="booking.name"/>
                                <p class="card-text">
                                    <strong>Service:</strong>
                                    <span t-esc="slot.service_id.name"/>
                                    <br/>
                                    <strong>Date:</strong>
                                    <span t-esc="slot.start_datetime"/>
                                    <br/>
                                    <strong>Contact:</strong>
                                    <span t-esc="booking.partner_name"/>
                                </p>
                                <p t-if="booking.partner_email">
                                    A confirmation email will be sent to <span t-esc="booking.partner_email"/>.
                                </p>
                            </div>
                        </div>
                        <a href="/appointments" class="btn btn-secondary mt-4">Back to appointments</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
