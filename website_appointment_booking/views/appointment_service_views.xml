<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_appointment_service_tree" model="ir.ui.view">
        <field name="name">appointment.service.tree</field>
        <field name="model">appointment.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="duration"/>
                <field name="next_slot_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_appointment_service_form" model="ir.ui.view">
        <field name="name">appointment.service.form</field>
        <field name="model">appointment.service</field>
        <field name="arch" type="xml">
            <form string="Appointment Service">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="action" class="oe_stat_button" name="%(action_appointment_slot)d" icon="fa-calendar">
                            <field name="slot_ids" string="Slots" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="duration"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Slots">
                            <field name="slot_ids">
                                <tree editable="bottom">
                                    <field name="name" readonly="1"/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="capacity"/>
                                    <field name="state"/>
                                    <field name="website_published"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
