<odoo>
    <data>
        <record id="view_res_config_settings_social_media" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.social.media</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.view_res_config_settings"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')][1]" position="inside">
                    <div class="app_settings_block" data-string="AI Content" string="AI Content">
                        <h2>OpenAI Integration</h2>
                        <div class="row mt16 o_setting_box">
                            <div class="col-12 col-lg-6">
                                <field name="openai_api_key" password="True" attrs="{'invisible': [('openai_api_key', '=', False)]}"/>
                                <label for="openai_api_key" string="OpenAI API Key"/>
                                <div class="text-muted">Configure the API key to enable ChatGPT powered content generation.</div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="res_config_settings_view_form_social_media" model="ir.ui.view">
            <field name="name">social.media.ai.settings.form</field>
            <field name="model">social.media.ai.settings</field>
            <field name="arch" type="xml">
                <form string="AI Settings">
                    <group>
                        <field name="openai_api_key" password="True"/>
                    </group>
                    <footer>
                        <button string="Save" type="object" name="execute" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
