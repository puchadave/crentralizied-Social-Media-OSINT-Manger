<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_postiz_bulk_publish_wizard" model="ir.ui.view">
        <field name="name">postiz.bulk.publish.wizard.form</field>
        <field name="model">postiz.bulk.publish.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk publish">
                <sheet>
                    <group>
                        <field name="post_ids" widget="many2many_tags"/>
                        <field name="action_type"/>
                        <field name="scheduled_at" attrs="{'invisible': [('action_type', '=', 'publish')]}"/>
                        <field name="notify_members" attrs="{'invisible': [('action_type', '=', 'publish')]}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
