<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="postiz_cron_publish_posts" model="ir.cron">
        <field name="name">Postiz - Publish scheduled posts</field>
        <field name="model_id" ref="model_postiz_social_post"/>
        <field name="state">code</field>
        <field name="code">model.cron_publish_due_posts()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="priority">5</field>
    </record>
    <record id="postiz_cron_sync_accounts" model="ir.cron">
        <field name="name">Postiz - Sync social analytics</field>
        <field name="model_id" ref="model_postiz_social_account"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_accounts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="priority">10</field>
    </record>
</odoo>
